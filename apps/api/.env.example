# Copy to .env (`cp .env.example .env`). Dev values only — never commit real ones.
# Ports avoid the usual 5432/6379, which are often taken on a developer's computer.

# Used by compose.yaml to create the containers.
POSTGRES_USER=flexikeys
POSTGRES_PASSWORD=flexikeys
POSTGRES_DB=flexikeys
MINIO_ROOT_USER=flexikeys
MINIO_ROOT_PASSWORD=flexikeys-dev

# Read by the server (app/settings.py) when it runs on your computer with `uv run`.
# Inside Docker, compose.yaml points these at the service names instead.
ENV=dev
DATABASE_URL=postgresql+asyncpg://flexikeys:flexikeys@localhost:5433/flexikeys
REDIS_URL=redis://localhost:6380/0
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=flexikeys
S3_SECRET_KEY=flexikeys-dev
S3_BUCKET=flexikeys
SMS_PROVIDER=fake
JWT_SECRET=dev-only-secret-change-me-in-any-real-place
# Encrypts health answers. This one is public and for dev only; production refuses it (docs/health-key.md).
HEALTH_KEYS=rns5GjXuzrOlYZEsm_Rpxq6AYW-NsEDRLg9XzFxbZSQ=
