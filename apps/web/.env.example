# Copy to .env.local (dev) or set in the deployment environment. Never commit real values.

# Public origin used for canonical URLs, hreflang, Open Graph and sitemap.xml (domain is TBC — PRD §2.1).
NEXT_PUBLIC_SITE_URL=https://flexikeys.uz

# Set to 1 at build time to include the /dev/design gallery in a production build (off by default).
FK_DEV_PAGES=0

# Which backend: "mock" (default — in-browser demo data) or "live" (the FastAPI backend at /api/v1).
NEXT_PUBLIC_API_MODE=mock
# Live mode: where the Next server forwards /api/v1 (production: the reverse proxy does it).
# Read at BUILD time (Next bakes rewrites into .next) — changing it later needs a rebuild.
FK_API_ORIGIN=http://localhost:8000
# Live mode: the file storage origin the browser may upload to and play from (signed links from the server).
# Read at BUILD time (it is part of the security headers). Dev: the MinIO of apps/api/compose.yaml.
FK_STORAGE_ORIGIN=http://localhost:9100
