# Copy to .env next to compose.yaml and fill in real values. Never commit .env: this repository is public.
DOMAIN=flexikeys.uz

POSTGRES_USER=flexikeys
POSTGRES_PASSWORD=change-me-long-and-random
POSTGRES_DB=flexikeys

# The server (apps/api/app/settings.py).
ENV=prod
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://files.flexikeys.uz
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-long-and-random
S3_BUCKET=flexikeys
SMS_PROVIDER=fake
JWT_SECRET=change-me-long-and-random
# The real health key, kept as docs/health-key.md says. The server refuses the public dev key in production.
HEALTH_KEYS=
