# FlexiKeys production settings. Copy to deploy/.env on the server and fill in real values:
#   cp .env.prod.example .env && chmod 600 .env
# Never commit .env: this repository is public. Make each secret with `openssl rand -base64 48`.

# --- Addresses ---------------------------------------------------------------------------------------------------
# The website's domain. Caddy also serves www. (a redirect), api. and files. of it. For a test on your computer: localhost
DOMAIN=flexikeys.org
# The website, for links in SMS
SITE_URL=https://flexikeys.org
# The server's own public address (the mobile app later, the load test). The website itself calls /api/v1 on DOMAIN
API_PUBLIC_URL=https://api.flexikeys.org
# Websites allowed to call api.<domain> from a browser (comma-separated). Only the website
CORS_ORIGINS=https://flexikeys.org
# The team's Telegram (or another help link) behind the parent's Help button. Empty = no Help button. Build-time
NEXT_PUBLIC_SUPPORT_URL=

# --- Database ----------------------------------------------------------------------------------------------------
# PostgreSQL user name
POSTGRES_USER=flexikeys
# PostgreSQL password: long and random
POSTGRES_PASSWORD=
# PostgreSQL database name
POSTGRES_DB=flexikeys

# --- File storage (MinIO on this server) -------------------------------------------------------------------------
# Where the server reaches MinIO inside Docker. Leave as it is
S3_ENDPOINT=http://minio:9000
# The address browsers upload to and play from; links are signed for it
S3_PUBLIC_ENDPOINT=https://files.flexikeys.org
# The website's security policy lets the browser load and upload files from here only (build-time)
FK_STORAGE_ORIGIN=https://files.flexikeys.org
# MinIO user name (also its admin user)
S3_ACCESS_KEY=flexikeys
# MinIO password: long and random, at least 8 characters
S3_SECRET_KEY=
# The bucket for every file. It is private: files are only reached with signed links
S3_BUCKET=flexikeys

# --- The server (apps/api/app/settings.py) -----------------------------------------------------------------------
# prod refuses unsafe settings (simulated SMS, the dev health key). dev only for a test on your own computer
ENV=prod
# The SMS provider. Only "fake" exists until B121 (Eskiz); prod refuses "fake"
SMS_PROVIDER=fake
# Signs sign-in tokens: long and random
JWT_SECRET=
# Encrypts health answers. Make and keep it as docs/health-key.md says; never the dev key from apps/api/.env.example
HEALTH_KEYS=
# The assistant's OpenRouter key. Empty = a pretend AI with fixed answers
OPENROUTER_API_KEY=
# The assistant's knowledge base on this server (needed in prod when OPENROUTER_API_KEY is set)
RESEARCH_PATH=
# Sign-in codes per IP address per hour. 50 parents in one hall share one Wi-Fi address: raise it for the event
OTP_PER_IP_PER_HOUR=200
# Server processes (compose.prod.yml): about 110 MB each; 4 kept 50 parents at once under 2 s (B120)
API_WORKERS=4
# Load test only (deploy/loadtest.mjs): any long random value turns the test sign-in on. UNSET IT AFTER THE TEST
FK_LOADTEST_SECRET=

# --- Backups (deploy/backup.sh) ----------------------------------------------------------------------------------
# A second machine for the backup copy, as user@host:/path (rsync over SSH with a key). Empty = this server only
BACKUP_TARGET=
